/scratch/
/.cache/
/.codex-dev/


# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.next-dev.*.log
.codex-*.log
*.stdout.log
*.stderr.log

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# large files
/data/iconify-icon-search.json
/data/iconify-icon-search.json.gz

