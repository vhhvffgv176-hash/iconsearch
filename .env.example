NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME
# Used to hash device sessions and Agent API keys. Changing it revokes existing credentials.
DEVICE_TOKEN_PEPPER=replace-with-at-least-32-random-characters
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# One-time Webflow Marketplace reviewer account preparation
WEBFLOW_REVIEW_EMAIL=marketplaceteam@webflow.com
WEBFLOW_REVIEW_PASSWORD=replace-with-the-password-entered-in-your-submission

# Canva OAuth provider. The client ID and secret must exactly match the values
# entered in Canva Developer Portal > Authentication. Canva displays the HTTPS
# redirect URI to copy here after OAuth is enabled for the app version.
CANVA_OAUTH_CLIENT_ID=replace-with-a-random-client-id
CANVA_OAUTH_CLIENT_SECRET=replace-with-a-long-random-client-secret
CANVA_OAUTH_REDIRECT_URI=https://www.canva.com/replace-with-the-exact-portal-redirect-uri
CANVA_OAUTH_TOKEN_PEPPER=replace-with-at-least-32-random-characters
