{
  "name": "iconsearch-canva-app",
  "version": "0.1.0",
  "private": true,
  "description": "Canva app for searching IconSearch and inserting SVG icons into designs.",
  "author": "iconsearch",
  "license": "MIT",
  "engines": {
    "node": "^22 || ^24"
  },
  "scripts": {
    "start": "webpack serve --config webpack.config.cjs --mode development",
    "build": "npm run typecheck && webpack --config webpack.config.cjs --mode production && npm run extract",
    "extract": "formatjs extract \"src/**/*.{ts,tsx}\" --out-file translations.json",
    "lint": "eslint src",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@canva/app-i18n-kit": "^1.3.0",
    "@canva/app-ui-kit": "^5.14.0",
    "@canva/asset": "^2.3.0",
    "@canva/design": "^2.10.1",
    "@canva/intents": "^2.6.0",
    "@canva/platform": "^2.2.2",
    "@canva/user": "^2.2.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-intl": "^7.1.14"
  },
  "devDependencies": {
    "@canva/app-eslint-plugin": "^1.0.0",
    "@formatjs/cli": "^6.16.16",
    "@formatjs/ts-transformer": "^4.4.18",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/webpack-env": "^1.18.8",
    "css-loader": "^7.1.2",
    "eslint": "^9.39.5",
    "style-loader": "^4.0.0",
    "ts-loader": "^9.5.4",
    "typescript": "^5.9.0",
    "webpack": "^5.105.0",
    "webpack-cli": "^6.0.0",
    "webpack-dev-server": "^5.2.0"
  }
}
